{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "football-live-score",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // every minute; each run checks the DB first and only calls API-Football while a match is on
  // every minute: live scores; "5 * * * *": dispatch the hourly GitHub data-sync (needs secret GITHUB_DISPATCH_TOKEN)
  "triggers": { "crons": ["* * * * *", "5 * * * *"] },
  // Supabase via Hyperdrive (see README "Live scores"). Created with --caching-disabled: the live gate must never read stale rows.
  // Local dev: set CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (non-TLS URL) in workers/live-score/.env
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "62619d5d61874535bcfc1db91995f9a3" }],
  // non-secret config; API_FOOTBALL_KEY is set with `wrangler secret put`
  "vars": {
    "TRACKED_LEAGUES": "39,140,135,78,61,296,5,2,3,848,1129,40,88,94,144,203,179,119,218,207,103,113,292,98,253,262,128,307,188",
    "SEASON": "2026",
    "LIVE_POLL_SECONDS": "30",
    "GITHUB_REPO": "tojobbws/football-data-analysis"
  },
  "observability": { "enabled": true },
  // cron only, no HTTP endpoint
  "workers_dev": false,
  "preview_urls": false
}
