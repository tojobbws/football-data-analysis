# ===== API-Football (api-sports.io) =====
# Dashboard: https://dashboard.api-football.com
API_FOOTBALL_KEY=your-api-sports-key
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# Requests per minute allowed by your plan (Free plan is low; check your dashboard)
API_FOOTBALL_RPM=10

# ===== Database (Supabase -> Project Settings -> Database -> Connection string) =====
# Use the "Session pooler" or direct connection URI. Workers write with this (bypasses RLS).
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ===== Scope =====
# Comma-separated API-Football league ids. MVP recommendation: 39 (Premier League), 140 (La Liga)
# 135 Serie A, 78 Bundesliga, 61 Ligue 1, 296 Thai League 1, 5 UEFA Nations League
# (verify ids with `npm run sync:leagues`)
TRACKED_LEAGUES=39,140
# API-Football season = starting year of the season (2026 = 2026/27)
SEASON=2026

# ===== Odds =====
# Markets to store: MATCH_WINNER, ASIAN_HANDICAP, OVER_UNDER (others are dropped to save space)
ODDS_MARKETS=MATCH_WINNER,ASIAN_HANDICAP,OVER_UNDER
# Optional: limit to specific bookmaker ids (comma-separated). Empty = all bookmakers returned.
ODDS_BOOKMAKERS=

# ===== Misc =====
LOG_LEVEL=info
