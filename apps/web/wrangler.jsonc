{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "football-data-analysis-web",
  // worker.ts: the OpenNext handler behind the public-page edge cache (src/lib/edge-cache.ts)
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Public address. Both hosts reach this Worker; middleware sends www (and workers.dev) to the apex with a 301.
  "routes": [
    { "pattern": "khemthitfootball.com", "custom_domain": true },
    { "pattern": "www.khemthitfootball.com", "custom_domain": true }
  ],
  // non-secret config; SUPABASE_ANON_KEY is set with `wrangler secret put` (or .dev.vars locally)
  "vars": {
    "SITE_URL": "https://khemthitfootball.com",
    "SUPABASE_URL": "https://tblynxlstpnxslzlvpol.supabase.co",
    "WEB_LEAGUES": "39,140,135,78,61,296,5,2,3,848,1129,40,88,94,144,203,179,119,218,207,103,113,292,98,253,262,128,307,188,71,48,536,36,7"
  }
}
